# in case Obsidian is ever opened from the wrong path
.obsidian/
.DS_Store
.idea/

# Agent working dirs — never commit (logs, scratch, output, verdicts).
# Vault content only; agent state stays local. (Maria, 2026-07-02)
# NOTE: root-anchored (/Agents/) so it does NOT catch the doctrine dir
# obsidian/_meta/agents/ on case-insensitive filesystems (macOS).
/Agents/
# Glob the children rather than the directory itself: git cannot re-include a
# path whose parent directory is excluded.
obsidian/Agents/*
