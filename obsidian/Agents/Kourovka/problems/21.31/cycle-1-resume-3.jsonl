+        " KC_ORDER=",Size(ClosureGroup(K,C)),
+        " CENTRALIZER_QUOTIENT_ORDER=",Size(C)/Size(Intersection(C,K)),
+        " GLOBAL_CENTRALIZER_FILTER=",ClosureGroup(K,C)=H,"\n");
+od;
+QUIT;

