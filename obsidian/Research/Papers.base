filters:
  and:
    - file.folder.startsWith("Research")
    - file.ext == "md"
    - file.hasTag("paper")
formulas:
  status_icon: if(status == "validated", "✅ synth.", if(status == "draft", "📖 unread", if(status == "review", "🔎 review", if(status == "rejected", "❌ rejected", if(status == "superseded", "♻️ superseded", "📝")))))
  topic_tags: file.tags.filter(value.startsWith("#topic/"))
properties:
  status:
    displayName: Status
  domain:
    displayName: Domain
  project:
    displayName: Project (optional)
  language:
    displayName: Lang
  methodology_type:
    displayName: Type
  year:
    displayName: Year
  authors:
    displayName: Authors
  author:
    displayName: Owned by
  citation_count:
    displayName: Cites
  formula.status_icon:
    displayName: Status
  formula.topic_tags:
    displayName: Topics
views:
  - type: table
    name: All papers — latest first
    order:
      - file.name
      - formula.status_icon
      - domain
      - language
      - methodology_type
      - project
      - year
      - authors
      - author
    sort:
      - property: year
        direction: DESC
      - property: file.name
        direction: ASC
    limit: 100
  - type: table
    name: Topics per paper
    order:
      - file.name
      - formula.topic_tags
      - domain
      - year
      - formula.status_icon
    sort:
      - property: domain
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      formula.topic_tags: 663
  - type: table
    name: By domain
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - language
      - year
      - authors
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By project (project-scoped papers only)
    filters:
      and:
        - project
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - domain
      - formula.status_icon
      - year
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: By language
    groupBy:
      property: language
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - domain
      - year
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Non-English papers (translation review)
    filters:
      and:
        - language != "en"
    order:
      - file.name
      - language
      - formula.status_icon
      - domain
      - year
      - author
    sort:
      - property: language
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: "Unread (status: draft)"
    filters:
      and:
        - status == "draft"
    order:
      - file.name
      - domain
      - language
      - year
      - author
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: "Synthesized (status: validated)"
    filters:
      and:
        - status == "validated"
    order:
      - file.name
      - domain
      - language
      - project
      - year
    sort:
      - property: file.name
        direction: ASC
