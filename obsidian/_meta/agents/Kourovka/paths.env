# Kourovka crew — machine-local config. EDIT THE TWO PATHS ONCE, THEN NEVER AGAIN.
#
# This is the single source of truth for every absolute path in the program, and
# for UTC timestamp arithmetic. No other file in the crew hard-codes either.
# See [[kourovka-crew-setup]] §2.
#
#   source "<your-vault>/_meta/agents/Kourovka/paths.env"
#
# This program runs on Windows, in a Linux shell — WSL2/Ubuntu by default, Git Bash
# as the fallback. Paths here are therefore POSIX, not Windows:
#
#   Windows   C:\Users\Ada\Documents\Obsidian\Math\obsidian
#   WSL2      /mnt/c/Users/Ada/Documents/Obsidian/Math/obsidian     <- use this
#   Git Bash  /c/Users/Ada/Documents/Obsidian/Math/obsidian         <- or this
#
# Forward slashes, always. Both values MUST be absolute.
#
# Do NOT use $HOME or ~ for the vault. Under WSL2, $HOME is the *Linux* home
# (/home/<you>), not your Windows user folder, so `$HOME/Documents/...` silently
# points at the wrong place — or nowhere. Spell the /mnt/c path out.
#
# If you don't know your exact path: open the vault folder in Windows Explorer,
# click the address bar, copy it, and convert it with
#     wslpath -u 'C:\Users\Ada\Documents\Obsidian\Math\obsidian'      (WSL2 only)

# Root of the Obsidian vault. The agents' working directory.
# Must be the folder that directly contains _meta/, Research/, Agents/, Experiments/.
KOUROVKA_VAULT="/mnt/c/Users/CHANGEME/Documents/Obsidian/Math/obsidian"

# Directory containing the source PDF. Agents get READ access to this directory
# and nothing else outside the vault. May be anywhere; it is not part of the vault.
KOUROVKA_PAPERS="/mnt/c/Users/CHANGEME/Documents/papers"

# Filename of the Kourovka Notebook PDF inside $KOUROVKA_PAPERS.
# Note the space — keep every reference quoted.
KOUROVKA_PDF_NAME="Kourovka 2022.pdf"


# ---- derived; do not edit ----------------------------------------------------
KOUROVKA_PDF="$KOUROVKA_PAPERS/$KOUROVKA_PDF_NAME"
export KOUROVKA_VAULT KOUROVKA_PAPERS KOUROVKA_PDF_NAME KOUROVKA_PDF

# ---- UTC clock; do not edit --------------------------------------------------
# The timing contract ([[_common-kourovka]] §3) is in UTC. GNU date (WSL2, Ubuntu,
# Git Bash) and BSD date (macOS) use incompatible flags for relative time, so both
# are wrapped here. Always use these helpers; never write a bare `date` in a spawn
# command, or the deadline will be wrong on somebody's machine.
#
#   kv_now              -> 2026-08-11T14:03:00Z
#   kv_deadline 3       -> the same instant plus 3 hours
if date --version >/dev/null 2>&1; then          # GNU coreutils
  kv_now()      { date -u +%Y-%m-%dT%H:%M:%SZ; }
  kv_deadline() { date -u -d "+${1} hours" +%Y-%m-%dT%H:%M:%SZ; }
else                                              # BSD
  kv_now()      { date -u +%Y-%m-%dT%H:%M:%SZ; }
  kv_deadline() { date -u -v+"${1}"H +%Y-%m-%dT%H:%M:%SZ; }
fi

# ---- self-check --------------------------------------------------------------
# Prints to stderr if something is wrong. Silent when correct.
case "$KOUROVKA_VAULT" in
  *CHANGEME*) echo "paths.env: not configured yet — edit KOUROVKA_VAULT and KOUROVKA_PAPERS. See [[kourovka-crew-setup]] §2." >&2 ;;
  *\\*)       echo "paths.env: backslashes in KOUROVKA_VAULT. Use /mnt/c/... not C:\\..." >&2 ;;
esac
[ -d "$KOUROVKA_VAULT/_meta/agents/Kourovka" ] \
  || echo "paths.env: KOUROVKA_VAULT does not look like the vault: $KOUROVKA_VAULT" >&2
[ -f "$KOUROVKA_PDF" ] \
  || echo "paths.env: PDF not found: $KOUROVKA_PDF" >&2
[ "$(kv_deadline 3)" \> "$(kv_now)" ] \
  || echo "paths.env: kv_deadline is not producing a future timestamp — check your date(1)." >&2
